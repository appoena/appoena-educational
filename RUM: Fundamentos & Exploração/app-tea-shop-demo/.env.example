# Datadog Agent
DD_API_KEY=
DD_SITE=
DD_LOGS_ENABLED=true
DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=true
DD_PROCESS_AGENT_ENABLED=true
DD_TAGS='env:dev'

# Datadog APM
DD_ENV=dev
DD_SERVICE=tea-shop-demo-backend
DD_VERSION=1.0.0
DD_LOGS_INJECTION=true
DD_TRACE_ENABLED=true

# Datadog RUM
# Copie este arquivo para .env e preencha os valores do seu app RUM.
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=
VITE_DD_ENV=
VITE_DD_SERVICE=tea-shop-demo-frontend
VITE_DD_VERSION=

# Opcional: deixe vazio para o frontend escolher automaticamente:
# - http://localhost:3000 quando aberto no host
# - http://backend:3000 quando aberto pelo bot dentro do Docker
VITE_API_BASE_URL=

# Bot Playwright
FRONTEND_URL=http://frontend:5173
BOT_CONCURRENCY=3
BOT_HEADLESS=true
BOT_MIN_DELAY_MS=300
BOT_MAX_DELAY_MS=3000